generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  firstName     String
  lastName      String
  phone         String?
  role          String    @default("USER")  // USER, AGENT, ADMIN, CEO
  verified      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Signup tracking
  signupMethod  String    @default("WEBSITE")  // WEBSITE, INVITE, AGENT_INVITE
  invitedBy     String?   // Transaction ID or Admin ID if invited
  ipAddress     String?
  userAgent     String?

  // Agent permissions (for AGENT role)
  agentPermissions String?   // JSON: {"canViewUsers":true,"canApproveKYC":false,...}
  agentInvitedBy   String?   // CEO/Admin who invited this agent
  agentInviteToken String?   @unique
  agentStatus      String?   @default("ACTIVE") // ACTIVE, SUSPENDED, REVOKED

  // KYC fields
  kycStatus     String    @default("PENDING")  // PENDING, SUBMITTED, APPROVED, REJECTED
  kycSubmittedAt DateTime?
  kycReviewedAt DateTime?
  kycReviewedBy String?
  kycRejectReason String?

  // KYC personal info
  kycFirstName  String?
  kycMiddleName String?
  kycLastName   String?
  dateOfBirth   String?
  nationality   String?
  kycPhone      String?   @unique // Unique phone per verified user
  ssn           String?   @unique // Tax ID / SSN / SIN - unique per user
  address       String?
  addressLine2  String?
  city          String?
  state         String?   // State / Province / Region
  zipCode       String?   // ZIP / Postal code
  country       String?

  // KYC documents
  idFrontUrl    String?
  idBackUrl     String?
  selfieUrl     String?
  idType        String?   // DRIVERS_LICENSE, PASSPORT, STATE_ID

  // OTP verification
  emailVerified     Boolean   @default(false)
  otpCode           String?
  otpExpiresAt      DateTime?
  otpAttempts       Int       @default(0)
  otpLastSentAt     DateTime?

  // Session management
  lastActiveAt      DateTime?
  sessionToken      String?

  createdTransactions     Transaction[] @relation("CreatedTransactions")
  counterpartyTransactions Transaction[] @relation("CounterpartyTransactions")
  sentMessages            Message[] @relation("SentMessages")
  receivedMessages        Message[] @relation("ReceivedMessages")
}

model Transaction {
  id              String    @id @default(cuid())
  transactionId   String    @unique @default(cuid())
  title           String
  type            String
  status          String    @default("PENDING_ACCEPTANCE")
  amount          Float
  currency        String    @default("USD")
  description     String
  inspectionDays  Int       @default(3)
  terms           String?

  // Creator info
  creatorId       String
  creator         User      @relation("CreatedTransactions", fields: [creatorId], references: [id])
  creatorRole     String    // "buyer" or "seller"

  // Counterparty info
  counterpartyEmail String
  counterpartyName  String
  counterpartyId    String?
  counterparty      User?     @relation("CounterpartyTransactions", fields: [counterpartyId], references: [id])

  // Invite
  inviteToken     String    @unique @default(cuid())
  inviteCode      String?   @unique // Short 8-char code for manual entry (nullable for existing records)
  inviteAccepted  Boolean   @default(false)
  inviteAcceptedAt DateTime?

  // Admin controls
  adminNotes      String?
  cancelledAt     DateTime?
  cancelledBy     String?
  cancelReason    String?
  completedAt     DateTime?
  completedBy     String?

  // Legacy fields
  buyerId         String?
  sellerEmail     String?
  sellerName      String?
  escrowFee       Float     @default(0)
  totalAmount     Float     @default(0)
  releaseDate     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  images          TransactionImage[]
  documents       Document[]
  messages        Message[]
  timeline        TimelineEvent[]
}

model TransactionImage {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  url           String
  order         Int         @default(0)
  createdAt     DateTime    @default(now())
}

model Document {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  name          String
  url           String
  type          String      // pdf, image, etc.
  uploadedBy    String      // User ID or "ADMIN"
  uploadedByRole String     @default("USER") // USER, ADMIN
  visibility    String      @default("ADMIN_ONLY") // ADMIN_ONLY, CREATOR_ONLY, COUNTERPARTY_ONLY, BOTH_PARTIES, ALL
  uploadedAt    DateTime    @default(now())
}

model Message {
  id            String      @id @default(cuid())
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  senderId      String?     // Null for system messages
  sender        User?       @relation("SentMessages", fields: [senderId], references: [id])
  receiverId    String?     // Null for broadcast messages
  receiver      User?       @relation("ReceivedMessages", fields: [receiverId], references: [id])
  content       String
  isSystem      Boolean     @default(false) // True for HoldVera system messages
  read          Boolean     @default(false)
  createdAt     DateTime    @default(now())
}

model TimelineEvent {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  event         String
  description   String
  createdAt     DateTime    @default(now())
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String
  company   String?
  content   String
  rating    Int      @default(5)
  avatar    String?
  featured  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SiteSettings {
  id              String  @id @default("settings")
  companyName     String  @default("HoldVera")
  tagline         String  @default("Trust. Secure. Delivered.")
  email           String  @default("support@holdvera.site")
  phone           String  @default("+1 (703) 555-0100")
  address         String  @default("Arlington, Virginia, USA")
  escrowFeePercent Float  @default(2.5)
}

model AdminEmail {
  id          String    @id @default(cuid())
  fromEmail   String    // ceo@holdvera.site or support@holdvera.site
  toEmail     String
  toName      String?
  subject     String
  body        String    // Plain text body
  htmlBody    String?   // Rendered HTML with template
  status      String    @default("SENT") // DRAFT, SENT, FAILED
  direction   String    // OUTBOUND or INBOUND (for future)
  parentId    String?   // For reply chains
  parent      AdminEmail? @relation("EmailReplies", fields: [parentId], references: [id])
  replies     AdminEmail[] @relation("EmailReplies")
  templateId  String?   // Which template was used
  sentBy      String?   // Admin user ID who sent it
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model EmailTemplate {
  id          String    @id @default(cuid())
  name        String    @unique
  subject     String
  body        String    // Template with {{placeholders}}
  category    String    @default("general") // general, kyc, transaction, support
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
